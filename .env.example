# ============================================================
#  浅浅 qianqian · 环境变量模板
#  用法：复制成 .env.local 后填写（.env.local 不会被提交到仓库）
#     Windows:  copy .env.example .env.local
#     macOS/Linux:  cp .env.example .env.local
# ============================================================

# ---------- 数据库（必填）----------
# PostgreSQL 连接串，格式：postgresql://用户名:密码@主机:端口/库名
# 填好后执行 `npm run setup`：会自动建库 + 建表 + 初始化账号
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/qianqian

# ---------- 模型（选填）----------
# 不填也能用：只是没有 AI 对话和自动识别，其余功能（课程 / 资料 / 任务 / 复习计划 / 账号 / 同步）都正常，
# 界面会显示「手动模式」。也可以之后在应用里的「设置 → 模型」填自己的接口。
#
# Agent 对话与工具调用用的模型
DEEPSEEK_AGENT_MODEL=deepseek-v4-flash
# 文件 / 截图信息抽取用的模型（需要多模态能力）
DEEPSEEK_EXTRACT_MODEL=deepseek-v4-flash
# 模型密钥与接口地址（OpenAI 兼容即可）
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
